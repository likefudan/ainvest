#!/usr/bin/env bash

set -euo pipefail

REPOSITORY_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPOSITORY_ROOT}"

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required. Install it from https://docs.astral.sh/uv/." >&2
  exit 127
fi

usage() {
  cat <<'EOF'
Usage: ./scripts/dev <command>

Commands:
  setup          Create/update the Python 3.12 development environment
  broker-install Install the locked broker profile with hash-verifying pip
  lock           Regenerate uv.lock after an intentional dependency change
  lock-check     Verify pyproject.toml and uv.lock are consistent
  format         Apply Ruff formatting and safe lint fixes
  format-check   Check formatting without modifying files
  lint           Run Ruff lint checks
  type-check     Run strict mypy checks
  unit           Run unit tests
  contract       Run contract tests
  integration    Run integration tests
  test           Run all tests with coverage
  export-schemas Write or check committed JSON Schema snapshots
  audit          Audit every locked dependency group and optional extra
  verify         Run every required local merge check
EOF
}

# The `broker` extra is installed by pip and not by `uv sync`, and that is a
# security requirement rather than a preference.
#
# `ainvest.execution.robinhood.artifact` verifies the installed `rh-mcp`
# against a pinned wheel SHA-256 that it reads out of the PEP 610
# `direct_url.json` the installer writes. pip records that digest under
# `archive_info.hashes`. uv writes `"archive_info": {}` for every install shape
# it offers — URL, local file, `uv pip install --require-hashes`, `uv sync` —
# on both uv 0.11.26 (pinned in CI) and 0.12.3, so a uv-installed gateway fails
# closed at startup with `artifact_digest_absent`. Rather than relax the check
# to fit the installer, the installer changes.
#
# uv remains the lock authority: the requirement, its URL and its hash all come
# out of `uv.lock` via `uv export`, and `--require-hashes` makes pip refuse any
# artifact that does not match. Nothing here is a second source of truth.
BROKER_PROFILE_EXPORT_ARGS=(
  --locked
  --no-default-groups
  --extra broker
  --no-emit-project
)

run_broker_install() (
  local requirements
  requirements="$(mktemp "${TMPDIR:-/tmp}/ainvest-broker.XXXXXX")"
  trap 'rm -f -- "${requirements}"' EXIT
  uv export \
    --quiet \
    "${BROKER_PROFILE_EXPORT_ARGS[@]}" \
    --format requirements.txt \
    --output-file "${requirements}"
  uv run --locked python -m pip install \
    --quiet \
    --require-hashes \
    --requirement "${requirements}"
)

run_format_check() {
  uv run --locked ruff format --check .
}

run_lint() {
  uv run --locked ruff check .
}

run_type_check() {
  uv run --locked mypy
}

run_unit() {
  uv run --locked pytest tests/unit
}

run_contract() {
  uv run --locked pytest tests/contract
}

run_integration() {
  uv run --locked pytest tests/integration
}

run_test() {
  uv run --locked pytest \
    --cov=ainvest \
    --cov-report=term-missing \
    --cov-fail-under=80
}

run_export_schemas_check() {
  uv run --locked python scripts/export_json_schemas.py --check
}

run_audit() (
  local audit_file
  audit_file="$(mktemp "${TMPDIR:-/tmp}/ainvest-audit.XXXXXX")"
  trap 'rm -f -- "${audit_file}"' EXIT
  uv export \
    --quiet \
    --locked \
    --all-extras \
    --all-groups \
    --no-emit-project \
    --output-file "${audit_file}"
  uv run --locked pip-audit \
    --disable-pip \
    --requirement "${audit_file}"
)

case "${1:-}" in
  setup)
    uv sync --locked
    run_broker_install
    ;;
  broker-install)
    run_broker_install
    ;;
  lock)
    uv lock
    ;;
  lock-check)
    uv lock --check
    ;;
  format)
    uv run --locked ruff format .
    uv run --locked ruff check --fix .
    ;;
  format-check)
    run_format_check
    ;;
  lint)
    run_lint
    ;;
  type-check)
    run_type_check
    ;;
  unit)
    run_unit
    ;;
  contract)
    run_contract
    ;;
  integration)
    run_integration
    ;;
  test)
    run_test
    ;;
  export-schemas)
    shift
    uv run --locked python scripts/export_json_schemas.py "$@"
    ;;
  audit)
    run_audit
    ;;
  verify)
    uv lock --check
    # Before the checks, not as one of them: the artifact pin is verified
    # against the real installed distribution, so the gate has to be running
    # against the profile it claims to gate. `uv run` syncs inexactly, so this
    # survives every later step.
    run_broker_install
    run_format_check
    run_lint
    run_type_check
    run_unit
    run_export_schemas_check
    run_contract
    run_integration
    run_test
    ;;
  help | --help | -h)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
