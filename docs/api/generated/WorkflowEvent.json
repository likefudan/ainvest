        "correlation_id": {
          "maxLength": 133,
          "minLength": 13,
          "pattern": "^corr_[A-Za-z0-9_-]{8,128}$",
          "title": "Correlation Id",
          "type": "string"
        },
        "event_id": {
          "maxLength": 133,
          "minLength": 12,
          "pattern": "^evt_[A-Za-z0-9_-]{8,128}$",
          "title": "Event Id",
