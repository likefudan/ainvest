        "event_type": {
          "const": "APPROVAL_CONSUMED",
          "default": "APPROVAL_CONSUMED",
          "title": "Event Type",
          "type": "string"
        },
        "idempotency_id": {
          "maxLength": 133,
          "minLength": 13,
          "pattern": "^idem_[A-Za-z0-9_-]{8,128}$",
          "title": "Idempotency Id",
          "type": "string"
        },
        "occurred_at": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "pattern": "(?:Z|[+-]\\d{2}:\\d{2})$",
          "title": "Occurred At",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/CommandOutcome"
        },
        "output_digest": {
          "anyOf": [
            {
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Digest"
        },
        "proposal_id": {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
          "title": "Proposal Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 2,
              "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
