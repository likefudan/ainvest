        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "correlation_id",
        "idempotency_id",
        "issued_at",
        "challenge_id",
        "proposal_id",
        "order_hash",
        "approved"
      ],
      "title": "ConsumeApprovalCommand",
      "type": "object"
