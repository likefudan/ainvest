{
  "$defs": {
    "ActorKind": {
      "description": "Who issued the command.",
      "enum": [
        "system",
        "strategy",
        "user",
        "operator"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "CancelOrderCommand": {
      "additionalProperties": false,
      "description": "Cancel a working broker order (separate cancel idempotency ID).\n\nRetry semantics are ``BROKER_WRITE``: never blind-retry an uncertain cancel.\nCancellation is privileged (design §5.6): requires an authenticated operator.",
      "properties": {
        "actor_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_kind": {
          "const": "operator",
          "default": "operator",
          "title": "Actor Kind",
          "type": "string"
        },
        "broker_order_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Broker Order Id",
          "type": "string"
        },
        "cancel_id": {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
          "title": "Cancel Id",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 133,
              "minLength": 12,
              "pattern": "^(cmd|evt|corr)_[A-Za-z0-9_-]{8,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "command_id": {
          "maxLength": 133,
          "minLength": 12,
          "pattern": "^cmd_[A-Za-z0-9_-]{8,128}$",
          "title": "Command Id",
          "type": "string"
        },
        "command_type": {
          "const": "CANCEL_ORDER",
          "default": "CANCEL_ORDER",
          "title": "Command Type",
          "type": "string"
        },
        "correlation_id": {
          "maxLength": 133,
          "minLength": 13,
          "pattern": "^corr_[A-Za-z0-9_-]{8,128}$",
          "title": "Correlation Id",
          "type": "string"
        },
        "idempotency_id": {
          "maxLength": 133,
          "minLength": 13,
          "pattern": "^idem_[A-Za-z0-9_-]{8,128}$",
          "title": "Idempotency Id",
          "type": "string"
        },
        "input_digest": {
          "anyOf": [
            {
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Digest"
        },
        "issued_at": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "pattern": "(?:Z|[+-]\\d{2}:\\d{2})$",
          "title": "Issued At",
          "type": "string"
        },
        "order_hash": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Order Hash",
          "type": "string"
        },
        "proposal_id": {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
          "title": "Proposal Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "reason_code": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Reason Code",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "correlation_id",
        "idempotency_id",
        "issued_at",
        "actor_id",
        "cancel_id",
        "proposal_id",
        "broker_order_id",
        "order_hash",
        "reason_code"
      ],
      "title": "CancelOrderCommand",
      "type": "object"
    },
