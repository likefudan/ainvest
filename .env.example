# ainvest environment variable example (placeholders only).
# Copy to an untracked `.env` and replace PLACEHOLDER_* values.
# Never commit real tokens, account numbers, or live enablement.
#
# Precedence (see src/ainvest/config.py CONFIG_PRECEDENCE):
#   1) built-in fail-closed defaults
#   2) optional YAML files
#   3) environment / this .env file
#   4) explicit load_settings overrides
#
# Design defaults (design.md §12):
#   TRADING_MODE=paper
#   LIVE_TRADING_ENABLED=false
#   REQUIRE_HUMAN_APPROVAL=true
#   REGULAR_TRADING_HOURS_ONLY=true   # DEC-001; first release rejects false
#   REQUIRE_COMPLETE_RISK_LIMITS=true # DEC-002; first release rejects false

AINVEST_ENV=development

TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
REQUIRE_HUMAN_APPROVAL=true
REGULAR_TRADING_HOURS_ONLY=true
REQUIRE_COMPLETE_RISK_LIMITS=true

# AI (DEC-004): OpenAI gpt-5.6-sol, Responses API, medium, store=false,
# built-in web search off, model fallback off, at most two attempts.
AI__PROVIDER=openai
AI__MODEL=gpt-5.6-sol
AI__API=responses
AI__REASONING_EFFORT=medium
AI__STORE=false
AI__BUILTIN_WEB_SEARCH=false
AI__MODEL_FALLBACK=false
AI__MAX_ATTEMPTS=2
AI__PROMPT_VERSION=v1
AI__OPENAI_API_KEY=PLACEHOLDER_OPENAI_API_KEY

# Telegram staging bot (DEC-005 / proposed DEC-010). Disabled synthetic shape.
# Pass an explicit secrets_dir to load the exact file TELEGRAM_STAGING__BOT_TOKEN.
TELEGRAM_STAGING__ENABLED=false
# TELEGRAM_STAGING__BOT_TOKEN=
TELEGRAM_STAGING__EXPECTED_BOT_ID=900000001
TELEGRAM_STAGING__ALLOWED_RECIPIENTS=[{"user_id":900000101,"private_chat_id":900000201}]
TELEGRAM_STAGING__TRANSPORT=long_polling
TELEGRAM_STAGING__APPROVAL_METHOD=telegram
TELEGRAM_STAGING__APPROVAL_SCOPE=paper

# Telegram production bot — separate synthetic identity and bound recipient.
# Pass an explicit secrets_dir to load the exact file TELEGRAM_PRODUCTION__BOT_TOKEN.
TELEGRAM_PRODUCTION__ENABLED=false
# TELEGRAM_PRODUCTION__BOT_TOKEN=
TELEGRAM_PRODUCTION__EXPECTED_BOT_ID=900000002
TELEGRAM_PRODUCTION__ALLOWED_RECIPIENTS=[{"user_id":900000102,"private_chat_id":900000202}]
TELEGRAM_PRODUCTION__TRANSPORT=long_polling
TELEGRAM_PRODUCTION__APPROVAL_METHOD=telegram
TELEGRAM_PRODUCTION__APPROVAL_SCOPE=paper

# Live WebAuthn prerequisites (DEC-006 / DEC-015 / DEC-016).
# Incomplete live combinations fail closed at startup.
# WEBAUTHN__ORIGIN=https://approve.example.com
# WEBAUTHN__RP_ID=approve.example.com
# WEBAUTHN__CREDENTIAL_IDS=["cred_primary","cred_recovery"]
# WEBAUTHN__APPROVAL_METHOD=webauthn
# WEBAUTHN__APPROVAL_SCOPE=live
# WEBAUTHN__BOOTSTRAP_CLOSED=true
# WEBAUTHN__WEBAUTHN_SERVER_SECRET=PLACEHOLDER_WEBAUTHN_SERVER_SECRET

# Other secrets (never commit real values).
# DATABASE_PASSWORD=PLACEHOLDER_DATABASE_PASSWORD
# ROBINHOOD_OAUTH_TOKEN=PLACEHOLDER_ROBINHOOD_OAUTH_TOKEN
# Telegram account-bound reads accept no account value from environment or
# dotenv. Provision only the exact owner-only 0600 file
# <explicit-secrets-dir>/ROBINHOOD_READ_ACCOUNT_NUMBER with the dedicated
# ainvest-robinhood-account utility; never add that key to this file.
