{
  "$defs": {
    "FactValueKind": {
      "description": "Discriminated fundamental fact value kinds.",
      "enum": [
        "DECIMAL",
        "TEXT",
        "BOOLEAN"
      ],
      "title": "FactValueKind",
      "type": "string"
    },
    "FundamentalFact": {
      "additionalProperties": false,
      "description": "Immutable typed fundamental fact. Raw dicts are not allowed.",
      "properties": {
        "boolean_value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boolean Value"
        },
        "decimal_value": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decimal Value"
        },
        "key": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FactValueKind"
        },
        "text_value": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Value"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "key",
        "kind"
      ],
      "title": "FundamentalFact",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Freshness and source metadata required on every external datum.",
      "properties": {
        "is_delayed": {
          "default": false,
          "title": "Is Delayed",
          "type": "boolean"
        },
        "observed_at": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "quality_flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QualityFlag"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "received_at": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "source": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.:-]{1,63}$",
          "title": "Source",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "source",
        "observed_at",
        "received_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QualityFlag": {
      "description": "Machine-readable data-quality markers for provenance envelopes.",
      "enum": [
        "STALE",
        "DELAYED",
        "PARTIAL",
        "ESTIMATED",
        "CONFLICTING_SOURCES",
        "MISSING_FIELDS",
        "UNVERIFIED"
      ],
      "title": "QualityFlag",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Standardized fundamental facts with evidence-grade provenance.",
  "properties": {
    "as_of": {
      "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FundamentalFact"
      },
      "title": "Facts",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "default": "1.0",
      "maxLength": 32,
      "minLength": 3,
      "pattern": "^[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "symbol": {
      "maxLength": 10,
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9.]{0,9}$",
      "title": "Symbol",
      "type": "string"
    }
  },
  "required": [
    "symbol",
    "as_of",
    "provenance"
  ],
  "title": "FundamentalSnapshot",
  "type": "object"
}
