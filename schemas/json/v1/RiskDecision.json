{
  "$defs": {
    "RiskOutcome": {
      "description": "Aggregated risk decision outcomes.",
      "enum": [
        "APPROVED",
        "NEEDS_REVIEW",
        "REJECTED"
      ],
      "title": "RiskOutcome",
      "type": "string"
    },
    "RiskSeverity": {
      "description": "Violation severity for explainable risk aggregation.",
      "enum": [
        "INFO",
        "REVIEW",
        "HARD"
      ],
      "title": "RiskSeverity",
      "type": "string"
    },
    "RiskViolation": {
      "additionalProperties": false,
      "description": "One rule finding with a stable machine-readable code.",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rule_code": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Rule Code",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/RiskSeverity"
        }
      },
      "required": [
        "rule_code",
        "severity",
        "reason"
      ],
      "title": "RiskViolation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable risk outcome bound to a candidate or proposal.\n\nEvery decision carries both a machine-readable ``reason_code`` and a\nhuman-readable ``reason`` (design.md §5.4).",
  "properties": {
    "candidate_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "decided_at": {
      "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/RiskOutcome"
    },
    "proposal_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposal Id"
    },
    "reason": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "title": "Reason Code",
      "type": "string"
    },
    "risk_decision_id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
      "title": "Risk Decision Id",
      "type": "string"
    },
    "rule_set_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Rule Set Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "maxLength": 32,
      "minLength": 3,
      "pattern": "^[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "violations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RiskViolation"
      },
      "title": "Violations",
      "type": "array"
    }
  },
  "required": [
    "risk_decision_id",
    "outcome",
    "decided_at",
    "rule_set_version",
    "reason_code",
    "reason"
  ],
  "title": "RiskDecision",
  "type": "object"
}
