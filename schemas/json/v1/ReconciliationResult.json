{
  "$defs": {
    "ReconciliationOutcome": {
      "description": "Result of reconciling local state against broker truth.",
      "enum": [
        "MATCHED",
        "DIVERGED",
        "UNKNOWN",
        "MANUAL_REVIEW"
      ],
      "title": "ReconciliationOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Local vs broker reconciliation for an order or cancel.",
  "properties": {
    "broker_order_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Broker Order Id"
    },
    "cancel_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancel Id"
    },
    "observed_at": {
      "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/ReconciliationOutcome"
    },
    "proposal_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposal Id"
    },
    "reason_code": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "title": "Reason Code",
      "type": "string"
    },
    "reconciliation_id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
      "title": "Reconciliation Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "maxLength": 32,
      "minLength": 3,
      "pattern": "^[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "reconciliation_id",
    "outcome",
    "reason_code",
    "observed_at"
  ],
  "title": "ReconciliationResult",
  "type": "object"
}
