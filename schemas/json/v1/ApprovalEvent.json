{
  "$defs": {
    "ApprovalEventOutcome": {
      "description": "Result of consuming an approval challenge.",
      "enum": [
        "APPROVED",
        "DENIED",
        "EXPIRED",
        "REPLAYED"
      ],
      "title": "ApprovalEventOutcome",
      "type": "string"
    },
    "ApprovalMethod": {
      "description": "Allowed human-approval methods.",
      "enum": [
        "telegram",
        "webauthn"
      ],
      "title": "ApprovalMethod",
      "type": "string"
    },
    "ApprovalScope": {
      "description": "Approval authorization scope.",
      "enum": [
        "paper",
        "live"
      ],
      "title": "ApprovalScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable approval outcome consumed by execution.",
  "properties": {
    "approved_at": {
      "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "approver_identity": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Approver Identity",
      "type": "string"
    },
    "challenge_id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
      "title": "Challenge Id",
      "type": "string"
    },
    "event_id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
      "title": "Event Id",
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/ApprovalMethod"
    },
    "order_hash": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Order Hash",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/ApprovalEventOutcome"
    },
    "proposal_id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "maxLength": 32,
      "minLength": 3,
      "pattern": "^[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ApprovalScope"
    }
  },
  "required": [
    "event_id",
    "challenge_id",
    "proposal_id",
    "order_hash",
    "method",
    "scope",
    "outcome",
    "approved_at",
    "approver_identity"
  ],
  "title": "ApprovalEvent",
  "type": "object"
}
