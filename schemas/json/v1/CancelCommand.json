{
  "$defs": {
    "AccountScope": {
      "description": "Broker account partition observed by strategies and sizing.\n\n``paper`` is the safe default path. ``agentic`` matches the Robinhood\naccount scope used by design.md OrderProposal examples.",
      "enum": [
        "paper",
        "agentic"
      ],
      "title": "AccountScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Separate cancel intent. Never an in-place replace of a live order.",
  "properties": {
    "account_scope": {
      "$ref": "#/$defs/AccountScope"
    },
    "broker_order_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Broker Order Id",
      "type": "string"
    },
    "cancel_id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
      "title": "Cancel Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "order_hash": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Order Hash",
      "type": "string"
    },
    "proposal_id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "title": "Reason Code",
      "type": "string"
    },
    "requested_at": {
      "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "maxLength": 32,
      "minLength": 3,
      "pattern": "^[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "cancel_id",
    "proposal_id",
    "broker_order_id",
    "order_hash",
    "account_scope",
    "reason_code",
    "idempotency_key",
    "requested_at"
  ],
  "title": "CancelCommand",
  "type": "object"
}
