{
  "$defs": {
    "AccountScope": {
      "description": "Broker account partition observed by strategies and sizing.\n\n``paper`` is the safe default path. ``agentic`` matches the Robinhood\naccount scope used by design.md OrderProposal examples.",
      "enum": [
        "paper",
        "agentic"
      ],
      "title": "AccountScope",
      "type": "string"
    },
    "AssetType": {
      "description": "First-release tradeable asset classes.",
      "enum": [
        "EQUITY",
        "ETF"
      ],
      "title": "AssetType",
      "type": "string"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "description": "Provenanced citation for a research claim.\n\nNatural-language assertions without a deterministic source/locator cannot\nvalidate. Numeric values must cite a calculation or tool source.",
      "properties": {
        "calculation_source": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_.:-]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Source"
        },
        "evidence_id": {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "locator": {
          "maxLength": 512,
          "minLength": 3,
          "pattern": "^(tool|filing|quote|ohlcv|technical|fundamental|event|calc):[A-Za-z0-9][A-Za-z0-9._/#:-]{0,500}$",
          "title": "Locator",
          "type": "string"
        },
        "numeric_value": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Value"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "schema_version": {
          "default": "1.0",
          "maxLength": 32,
          "minLength": 3,
          "pattern": "^[0-9]+\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "summary",
        "provenance",
        "locator"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "EvidenceKind": {
      "description": "Allowed evidence categories. Free-form natural language is not evidence.",
      "enum": [
        "FILING",
        "QUOTE",
        "OHLCV",
        "TECHNICAL",
        "FUNDAMENTAL",
        "EVENT",
        "CALCULATED"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "ExposureSnapshot": {
      "additionalProperties": false,
      "description": "Aggregate exposure derived from cash and positions.",
      "properties": {
        "cash": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Cash",
          "type": "string"
        },
        "equity": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Equity",
          "type": "string"
        },
        "gross_market_value": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Gross Market Value",
          "type": "string"
        },
        "largest_position_weight": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Largest Position Weight",
          "type": "string"
        },
        "net_market_value": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Net Market Value",
          "type": "string"
        },
        "position_count": {
          "default": 0,
          "minimum": 0,
          "title": "Position Count",
          "type": "integer"
        }
      },
      "required": [
        "cash",
        "equity",
        "gross_market_value",
        "net_market_value",
        "largest_position_weight"
      ],
      "title": "ExposureSnapshot",
      "type": "object"
    },
    "InstrumentIdentity": {
      "additionalProperties": false,
      "description": "Canonical tradeable instrument identity.\n\nA display symbol alone is never sufficient to identify a broker instrument.",
      "properties": {
        "asset_type": {
          "$ref": "#/$defs/AssetType"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "exchange": {
          "maxLength": 4,
          "minLength": 4,
          "pattern": "^[A-Z0-9]{4}$",
          "title": "Exchange",
          "type": "string"
        },
        "identity_as_of": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "Identity As Of",
          "type": "string"
        },
        "instrument_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Instrument Id",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_.:-]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "symbol": {
          "maxLength": 10,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9.]{0,9}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "symbol",
        "exchange",
        "currency",
        "asset_type",
        "identity_as_of"
      ],
      "title": "InstrumentIdentity",
      "type": "object"
    },
    "OpenOrderSide": {
      "description": "Sides allowed on open-order snapshots (long-only first release).",
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "OpenOrderSide",
      "type": "string"
    },
    "OpenOrderSnapshot": {
      "additionalProperties": false,
      "description": "Outstanding broker order visible to strategies and pre-trade checks.",
      "properties": {
        "instrument": {
          "$ref": "#/$defs/InstrumentIdentity"
        },
        "limit_price": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Price"
        },
        "order_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Order Id",
          "type": "string"
        },
        "quantity": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/OpenOrderSide"
        },
        "submitted_at": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 10,
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9.]{0,9}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        }
      },
      "required": [
        "order_id",
        "instrument",
        "side",
        "quantity",
        "submitted_at"
      ],
      "title": "OpenOrderSnapshot",
      "type": "object"
    },
    "PortfolioSnapshot": {
      "additionalProperties": false,
      "description": "Immutable account snapshot consumed by StrategyContext and sizing.",
      "properties": {
        "account_scope": {
          "$ref": "#/$defs/AccountScope"
        },
        "as_of": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "buying_power": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Buying Power",
          "type": "string"
        },
        "cash": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Cash",
          "type": "string"
        },
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "equity": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Equity",
          "type": "string"
        },
        "exposure": {
          "$ref": "#/$defs/ExposureSnapshot"
        },
        "open_orders": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OpenOrderSnapshot"
          },
          "title": "Open Orders",
          "type": "array"
        },
        "positions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PositionSnapshot"
          },
          "title": "Positions",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "schema_version": {
          "default": "1.0",
          "maxLength": 32,
          "minLength": 3,
          "pattern": "^[0-9]+\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "account_scope",
        "as_of",
        "cash",
        "buying_power",
        "equity",
        "exposure",
        "provenance"
      ],
      "title": "PortfolioSnapshot",
      "type": "object"
    },
    "PositionSnapshot": {
      "additionalProperties": false,
      "description": "Single long position within a portfolio snapshot.",
      "properties": {
        "average_cost": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Cost"
        },
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "instrument": {
          "$ref": "#/$defs/InstrumentIdentity"
        },
        "market_value": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Market Value",
          "type": "string"
        },
        "portfolio_weight": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Portfolio Weight",
          "type": "string"
        },
        "quantity": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "unrealized_pnl": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unrealized Pnl"
        }
      },
      "required": [
        "instrument",
        "quantity",
        "market_value",
        "portfolio_weight"
      ],
      "title": "PositionSnapshot",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Freshness and source metadata required on every external datum.",
      "properties": {
        "is_delayed": {
          "default": false,
          "title": "Is Delayed",
          "type": "boolean"
        },
        "observed_at": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "quality_flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QualityFlag"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "received_at": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "source": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.:-]{1,63}$",
          "title": "Source",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "source",
        "observed_at",
        "received_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QualityFlag": {
      "description": "Machine-readable data-quality markers for provenance envelopes.",
      "enum": [
        "STALE",
        "DELAYED",
        "PARTIAL",
        "ESTIMATED",
        "CONFLICTING_SOURCES",
        "MISSING_FIELDS",
        "UNVERIFIED"
      ],
      "title": "QualityFlag",
      "type": "string"
    },
    "ResearchMarketSection": {
      "additionalProperties": false,
      "description": "Compact market section embedded in ResearchPacket (design.md §6.1).",
      "properties": {
        "ask": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ask"
        },
        "bid": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bid"
        },
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "last_price": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Last Price",
          "type": "string"
        },
        "observed_at": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "last_price",
        "observed_at",
        "provenance"
      ],
      "title": "ResearchMarketSection",
      "type": "object"
    },
    "ResearchPacket": {
      "additionalProperties": false,
      "description": "AI research output consumed by strategies (design.md §6.1).",
      "properties": {
        "as_of": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceCitation"
          },
          "title": "Evidence",
          "type": "array"
        },
        "instrument": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstrumentIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "market": {
          "$ref": "#/$defs/ResearchMarketSection"
        },
        "portfolio": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchPortfolioSection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quality_flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QualityFlag"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "research_id": {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
          "title": "Research Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "maxLength": 32,
          "minLength": 3,
          "pattern": "^[0-9]+\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        },
        "symbol": {
          "maxLength": 10,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9.]{0,9}$",
          "title": "Symbol",
          "type": "string"
        },
        "technical": {
          "anyOf": [
            {
              "$ref": "#/$defs/TechnicalIndicators"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "thesis": {
          "$ref": "#/$defs/ThesisSection"
        }
      },
      "required": [
        "research_id",
        "symbol",
        "as_of",
        "market"
      ],
      "title": "ResearchPacket",
      "type": "object"
    },
    "ResearchPortfolioSection": {
      "additionalProperties": false,
      "description": "Portfolio context embedded in a research packet (full portfolio is P02-T2).",
      "properties": {
        "buying_power": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Buying Power",
          "type": "string"
        },
        "market_value": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Market Value",
          "type": "string"
        },
        "portfolio_weight": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Portfolio Weight",
          "type": "string"
        },
        "quantity": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Quantity",
          "type": "string"
        }
      },
      "required": [
        "quantity",
        "market_value",
        "portfolio_weight",
        "buying_power"
      ],
      "title": "ResearchPortfolioSection",
      "type": "object"
    },
    "StrategyState": {
      "additionalProperties": false,
      "description": "Explicit strategy state bound to a strategy version.\n\nStrategies must not rely on class/global process state. Any retained state\nis read from here and returned as ``next_state`` by later runtime cards.",
      "properties": {
        "entries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StrategyStateItem"
          },
          "title": "Entries",
          "type": "array"
        },
        "strategy": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Strategy",
          "type": "string"
        },
        "strategy_version": {
          "maxLength": 32,
          "minLength": 5,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Strategy Version",
          "type": "string"
        },
        "updated_at": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "strategy_version",
        "updated_at"
      ],
      "title": "StrategyState",
      "type": "object"
    },
    "StrategyStateItem": {
      "additionalProperties": false,
      "description": "One immutable key/value entry in strategy state.\n\nScalar fields use strict JSON types so BOOLEAN/INTEGER kinds cannot coerce\nacross each other (e.g. ``true`` must not become integer ``1``).",
      "properties": {
        "boolean_value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boolean Value"
        },
        "decimal_value": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decimal Value"
        },
        "integer_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integer Value"
        },
        "key": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/StrategyStateValueKind"
        },
        "text_value": {
          "anyOf": [
            {
