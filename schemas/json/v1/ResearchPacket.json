{
  "$defs": {
    "AssetType": {
      "description": "First-release tradeable asset classes.",
      "enum": [
        "EQUITY",
        "ETF"
      ],
      "title": "AssetType",
      "type": "string"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "description": "Provenanced citation for a research claim.\n\nNatural-language assertions without a deterministic source/locator cannot\nvalidate. Numeric values must cite a calculation or tool source.",
      "properties": {
        "calculation_source": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_.:-]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Source"
        },
        "evidence_id": {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "locator": {
          "maxLength": 512,
          "minLength": 3,
          "pattern": "^(tool|filing|quote|ohlcv|technical|fundamental|event|calc):[A-Za-z0-9][A-Za-z0-9._/#:-]{0,500}$",
          "title": "Locator",
          "type": "string"
        },
        "numeric_value": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Value"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "schema_version": {
          "default": "1.0",
          "maxLength": 32,
          "minLength": 3,
          "pattern": "^[0-9]+\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "summary",
        "provenance",
        "locator"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "EvidenceKind": {
      "description": "Allowed evidence categories. Free-form natural language is not evidence.",
      "enum": [
        "FILING",
        "QUOTE",
        "OHLCV",
        "TECHNICAL",
        "FUNDAMENTAL",
        "EVENT",
        "CALCULATED"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "InstrumentIdentity": {
      "additionalProperties": false,
      "description": "Canonical tradeable instrument identity.\n\nA display symbol alone is never sufficient to identify a broker instrument.",
      "properties": {
        "asset_type": {
          "$ref": "#/$defs/AssetType"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "exchange": {
          "maxLength": 4,
          "minLength": 4,
          "pattern": "^[A-Z0-9]{4}$",
          "title": "Exchange",
          "type": "string"
        },
        "identity_as_of": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "Identity As Of",
          "type": "string"
        },
        "instrument_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Instrument Id",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_.:-]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "symbol": {
          "maxLength": 10,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9.]{0,9}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "symbol",
        "exchange",
        "currency",
        "asset_type",
        "identity_as_of"
      ],
      "title": "InstrumentIdentity",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Freshness and source metadata required on every external datum.",
      "properties": {
        "is_delayed": {
          "default": false,
          "title": "Is Delayed",
          "type": "boolean"
        },
        "observed_at": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "quality_flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QualityFlag"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "received_at": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "source": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.:-]{1,63}$",
          "title": "Source",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "source",
        "observed_at",
        "received_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QualityFlag": {
      "description": "Machine-readable data-quality markers for provenance envelopes.",
      "enum": [
        "STALE",
        "DELAYED",
        "PARTIAL",
        "ESTIMATED",
        "CONFLICTING_SOURCES",
        "MISSING_FIELDS",
        "UNVERIFIED"
      ],
      "title": "QualityFlag",
      "type": "string"
    },
    "ResearchMarketSection": {
      "additionalProperties": false,
      "description": "Compact market section embedded in ResearchPacket (design.md §6.1).",
      "properties": {
        "ask": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ask"
        },
        "bid": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bid"
        },
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "last_price": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Last Price",
          "type": "string"
        },
        "observed_at": {
          "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "last_price",
        "observed_at",
        "provenance"
      ],
      "title": "ResearchMarketSection",
      "type": "object"
    },
    "ResearchPortfolioSection": {
      "additionalProperties": false,
      "description": "Portfolio context embedded in a research packet (full portfolio is P02-T2).",
      "properties": {
        "buying_power": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Buying Power",
          "type": "string"
        },
        "market_value": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Market Value",
          "type": "string"
        },
        "portfolio_weight": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Portfolio Weight",
          "type": "string"
        },
        "quantity": {
          "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
          "maxLength": 64,
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Quantity",
          "type": "string"
        }
      },
      "required": [
        "quantity",
        "market_value",
        "portfolio_weight",
        "buying_power"
      ],
      "title": "ResearchPortfolioSection",
      "type": "object"
    },
    "TechnicalIndicators": {
      "additionalProperties": false,
      "description": "Deterministic technical indicator snapshot.",
      "properties": {
        "atr_14": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atr 14"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "rsi_14": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rsi 14"
        },
        "schema_version": {
          "default": "1.0",
          "maxLength": 32,
          "minLength": 3,
          "pattern": "^[0-9]+\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        },
        "sma_20": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sma 20"
        },
        "sma_50": {
          "anyOf": [
            {
              "description": "Canonical decimal string without scientific notation. Binary JSON numbers are rejected.",
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sma 50"
        },
        "symbol": {
          "maxLength": 10,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9.]{0,9}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "provenance"
      ],
      "title": "TechnicalIndicators",
      "type": "object"
    },
    "ThesisSection": {
      "additionalProperties": false,
      "description": "Structured thesis bullets. These are narrative, not evidence.",
      "properties": {
        "bear_case": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Bear Case",
          "type": "array"
        },
        "bull_case": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Bull Case",
          "type": "array"
        },
        "risks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        }
      },
      "title": "ThesisSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "AI research output consumed by strategies (design.md §6.1).",
  "properties": {
    "as_of": {
      "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceCitation"
      },
      "title": "Evidence",
      "type": "array"
    },
    "instrument": {
      "anyOf": [
        {
          "$ref": "#/$defs/InstrumentIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "market": {
      "$ref": "#/$defs/ResearchMarketSection"
    },
    "portfolio": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchPortfolioSection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quality_flags": {
      "default": [],
      "items": {
        "$ref": "#/$defs/QualityFlag"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "research_id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
      "title": "Research Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "maxLength": 32,
      "minLength": 3,
      "pattern": "^[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "symbol": {
      "maxLength": 10,
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9.]{0,9}$",
      "title": "Symbol",
      "type": "string"
    },
    "technical": {
      "anyOf": [
        {
          "$ref": "#/$defs/TechnicalIndicators"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "thesis": {
      "$ref": "#/$defs/ThesisSection"
    }
  },
  "required": [
    "research_id",
    "symbol",
    "as_of",
    "market"
  ],
  "title": "ResearchPacket",
  "type": "object"
}
