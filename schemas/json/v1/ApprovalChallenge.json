{
  "$defs": {
    "ApprovalChallengeStatus": {
      "description": "Lifecycle for a one-time approval challenge.",
      "enum": [
        "PENDING",
        "CONSUMED",
        "EXPIRED",
        "CANCELLED"
      ],
      "title": "ApprovalChallengeStatus",
      "type": "string"
    },
    "ApprovalMethod": {
      "description": "Allowed human-approval methods.",
      "enum": [
        "telegram",
        "webauthn"
      ],
      "title": "ApprovalMethod",
      "type": "string"
    },
    "ApprovalScope": {
      "description": "Approval authorization scope.",
      "enum": [
        "paper",
        "live"
      ],
      "title": "ApprovalScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One-time challenge bound to a proposal and order hash.",
  "properties": {
    "challenge_id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
      "title": "Challenge Id",
      "type": "string"
    },
    "created_at": {
      "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
      "format": "date-time",
      "pattern": "(?:Z|[+-]\\d{2}:\\d{2})$",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
      "format": "date-time",
      "pattern": "(?:Z|[+-]\\d{2}:\\d{2})$",
      "title": "Expires At",
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/ApprovalMethod"
    },
    "nonce_hash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "title": "Nonce Hash",
      "type": "string"
    },
    "order_hash": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Order Hash",
      "type": "string"
    },
    "proposal_id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ApprovalScope"
    },
    "status": {
      "$ref": "#/$defs/ApprovalChallengeStatus",
      "default": "PENDING"
    }
  },
  "required": [
    "challenge_id",
    "proposal_id",
    "order_hash",
    "method",
    "scope",
    "nonce_hash",
    "created_at",
    "expires_at"
  ],
  "title": "ApprovalChallenge",
  "type": "object"
}
