{
  "$defs": {
    "AccountScope": {
      "description": "Broker account partition observed by strategies and sizing.\n\n``paper`` is the safe default path. ``agentic`` matches the Robinhood\naccount scope used by design.md OrderProposal examples.",
      "enum": [
        "paper",
        "agentic"
      ],
      "title": "AccountScope",
      "type": "string"
    },
    "BrokerOrderStatus": {
      "description": "Broker-visible order statuses for first-release reconciliation.",
      "enum": [
        "ACCEPTED",
        "PARTIALLY_FILLED",
        "FILLED",
        "CANCELLED",
        "REJECTED",
        "UNKNOWN"
      ],
      "title": "BrokerOrderStatus",
      "type": "string"
    },
    "OrderSide": {
      "description": "First-release order sides. Short selling is not permitted.",
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "OrderSide",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Broker acknowledgement / working order snapshot.",
  "properties": {
    "account_scope": {
      "$ref": "#/$defs/AccountScope"
    },
    "broker_order_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Broker Order Id",
      "type": "string"
    },
    "client_order_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Client Order Id",
      "type": "string"
    },
    "order_hash": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Order Hash",
      "type": "string"
    },
    "proposal_id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^[a-z][a-z0-9_]{1,12}_[A-Za-z0-9_-]{4,128}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "side": {
      "$ref": "#/$defs/OrderSide"
    },
    "status": {
      "$ref": "#/$defs/BrokerOrderStatus"
    },
    "submitted_at": {
      "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
      "format": "date-time",
      "pattern": "(?:Z|[+-]\\d{2}:\\d{2})$",
      "title": "Submitted At",
      "type": "string"
    },
    "updated_at": {
      "description": "Timezone-aware UTC timestamp serialized with a trailing Z.",
      "format": "date-time",
      "pattern": "(?:Z|[+-]\\d{2}:\\d{2})$",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "broker_order_id",
    "client_order_id",
    "proposal_id",
    "order_hash",
    "account_scope",
    "side",
    "status",
    "submitted_at",
    "updated_at"
  ],
  "title": "BrokerOrder",
  "type": "object"
}
